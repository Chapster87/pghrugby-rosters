# Public browser Supabase client (safe to embed in static export).
# Copy to .env.local for local dev. DreamHost CI reads the same names from
# GitHub Actions repository variables (see deploy-dreamhost.yml).
#
# Never put SUPABASE_SERVICE_ROLE_KEY (or any service-role key) in NEXT_PUBLIC_*
# or commit it. Service-role is local/agent provisioning only.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
